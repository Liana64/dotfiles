direction: right

cluster: {
  grid-columns: 2

  n1: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Router, Kubernetes Node
      host-os: NixOS
      vms: talos, opnsense
    }
    hardware: {
      shape: sql_table
      platform: ms-01
      memory: G.SKILL 32 GB DDR5 5200 MT/s (2x16, 1R)
      processor: "Intel i5-12600H (4 C [P, 4.5 GHz], 8 C [E, 3.3 GHz], 16 T, 18 MB)"
      boot: 2x boot partitions, one per storage NVMe
      storage: "2x 1 TB NVMe (WD_BLACK SN770, WD Blue SN5100 [mirrored])"
      notes: "TODO: Switch to 500 GB NVMe boot disks and 2 TB storage for Piraeus"
      network: "On-board 2x 10Gb SFP+ (X710), 2x 2.5Gb Base-T, 2x USB4 (20Gb [40Gb int])"
      pcie: "M.2 Gen4 x4 (WD_BLACK), M.2 Gen3 x4, M.2 Gen3 x2, Gen4 x8 [x16 slot] (WD Blue)"
    }
    network: {
      shape: sql_table
      "0/1": LAN (bond0) {constraint: SFP+}
      "0/2": LAN (Planned, bond0) {constraint: SFP+}
      "0/3": WAN (Planned) {constraint: Base-T}
      "0/4": MGMT {constraint: Base-T}
      usb4/0: Piraeus (Maybe) {constraint: TB40}
      usb4/1: pfsync (Planned) {constraint: TB40}
    }
  }
  n2: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Router, Kubernetes Node
      host-os: NixOS
      vms: talos, opnsense
    }
    hardware: {
      shape: sql_table
      platform: ms-01
      memory: Crucial 32 GB DDR5 5200 MT/s (2x16, 1R)
      processor: "Intel i5-12600H (4 C [P, 4.5 GHz], 8 C [E, 3.3 GHz], 16 T, 18 MB)"
      boot: 2x boot partitions, one per storage NVMe
      storage: "2x 2 TB NVMe (Viper VP4300 2TB, WD_BLACK SN770 [4 TB raw])"
      network: "On-board 2x 10Gb SFP+ (X710), 2x 2.5Gb Base-T, 2x USB4 (20GB [40Gb int])"
      pcie: "M.2 Gen4 x4 (WD_BLACK), M.2 Gen3 x4, M.2 Gen3 x2 (Viper), Gen4 x8 [x16 slot] (unused)"
      notes: "TODO: Switch to 500 GB NVMe boot disks and 2 TB storage for Piraeus"
      notes-2: "TODO: Swap viper to other PCIe slot"
    }
    network: {
      shape: sql_table
      "0/1": LAN (bond0) {constraint: SFP+}
      "0/2": LAN (bond0) {constraint: SFP+}
      "0/3": WAN {constraint: Base-T}
      "0/4": MGMT {constraint: Base-T}
      usb4/0: Piraeus (Maybe) {constraint: TB40}
      usb4/1: pfsync (Planned) {constraint: TB40}
    }
  }
  n3: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Kubernetes etcd quorum
      host-os: NixOS
      vms: talos, rhel lab
    }
    hardware: {
      shape: sql_table
      platform: Dell Optiplex 7050 Micro
      memory: 16 GB DDR4 2400 MT/s (2x8, 1R)
      processor: Intel i7-7700T (4 C, 8 T, 2.9 GHz, 8 MB)
      boot: Not redundant
      storage: 256 GB NVMe, 256 GB SATA SSD
      pcie: Gen3 x4 (NVMe), x2 (unused)
    }
    network: {
      shape: sql_table
      "0/1": Cluster {constraint: Base-T}
      usb1: MGMT {constraint: Adapter}
    }
  }
  m1: {
    grid-columns: 2
    specs: {
      direction: down
      os: {
        shape: sql_table
        role: Storage
        host-os: NixOS
        vms: talos
      }
      hardware: {
        shape: sql_table
        platform: ASUS TUF Z390M-PRO GAMING (WI-FI)
        memory: TEAMGROUP 64 GB DDR4 (4x16, 1R)
        processor: "Intel i7-9700k (8 C, 8 T, 12 MB)"
        boot: 2x boot partitions, one per NVMe
        storage: "2x Patriot P300 512 GB (mirrored), 2x Seagate 28 T (56 T raw [mirrored])"
        network: 2x 10Gb SFP+ (X710), 1x 1Gb Base-T (I219-V)
        pcie: "Gen3 x8 (X710), Gen3 x8 (GTX 1080, vfio), 2x M.2 Gen3 x4 (P300), 2x Gen3 x1 (unused)"
        notes: "TODO: Swap 500 GB NVMes for 1 TB NVMes from other devices, post-Piraeus"
      }
      network: {
        shape: sql_table
        "0/1": MGMT {constraint: Base-T}
        "1/1": LAN (bond0) {constraint: SFP+}
        "1/2": LAN (bond0) {constraint: SFP+}
      }
    }
    services: {
      userspace: |md
        - nfs-ganesha
        - seaweedfs
        - attic
        - attic-metrics
      |
    }
    libvirtd: |md
      talos
    |
  }
}
home: {
  # CP1500PFCLCDa
  oob: {
    os: {
      shape: sql_table
      role: Out of Band
      host-os: "TODO: NixOS"
    }
    hardware: {
      shape: sql_table
      platform: Raspberry Pi 5 Model B Rev 1.1
      memory: 8 GB LPDDR4X-4267
      processor: Cortex-A76 (4C, 1.5-2.4 GHz)
      boot: Non-redundant
      storage: 256 GB NVMe Kioxia BG5 Gen4 (Gen2), 32 GB SanDisk microSD
      network: 1 GbE Base-T, 802.11ac Wi-Fi/Bluetooth
      usb: 1x USB 2.0 UPS monitor, 2x USB 3.0, 1x USB 2.0
      pcie: 1x, NVMe and PoE Hat
      power: 5.18 V and 5 A
    }
    network: {
      shape: sql_table
      "0/1": MGMT/PoE {constraint: Base-T}
    }
  }
  catbox: {
    os: {
      shape: sql_table
      role: Gaming PC, TV
      host-os: NixOS
    }
    hardware: {
      shape: sql_table
      memory: Corsair 32 GB DDR5 5200 MT/s (2x16, 1R)
      board: "Gigabyte B850 GAMING X WIFI6E"
      processor: "AMD RYZEN 7 9800X3D"
      boot: Non-redundant
      storage: 2 TB Samsung 970 EVO Plus
      network: TODO
      usb: TP-Link UB500 Adapter
      pcie: AMD Radeon RX 7900 XT
    }
    network: {
      shape: sql_table
      "0/1": Home {constraint: Base-T}
    }
  }
}
