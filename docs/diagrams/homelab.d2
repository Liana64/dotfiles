direction: right

cluster: {
  grid-columns: 2

  n1: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Router, Kubernetes Node
      host-os: NixOS (Planned)
      vms: talos, opnsense
    }
    hardware: {
      shape: sql_table
      platform: ms-01
      memory: G.SKILL 32 GB DDR5 5200 MT/s (2x16, 1R)
      processor: "Intel i5-12600H (4 C [P, 4.5 GHz], 8 C [E, 3.3 GHz], 16 T, 18 MB)"
      boot: 2x boot partitions, one per storage NVMe (planned)
      storage: 256 GB NVMe (WD Blue SN580), 1 TB NVMe (WD_BLACK SN770), 1 TB NVMe (WD Blue SN5100, Planned)
      notes: "TODO: Move 1 TB NVMe from n2 to n1 for redundant boot"
      network: "On-board 2x 10Gb SFP+ (X710), 2x 2.5Gb Base-T, 2x USB4 (20Gb [40Gb int])"
      pcie: Gen4 x16, unused
    }
    network: {
      shape: sql_table
      "0/1": LAN (bond0) {constraint: SFP+}
      "0/2": LAN (bond0) {constraint: SFP+}
      "0/3": MGMT {constraint: Base-T}
      "0/4": WAN (Planned) {constraint: Base-T}
      usb4/0: empty {constraint: TB40}
      usb4/1: pfsync (Planned) {constraint: TB40}
    }
  }
  n2: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Router, Kubernetes Node
      host-os: NixOS
      vms: talos, opnsense (planned)
    }
    hardware: {
      shape: sql_table
      platform: ms-01
      memory: Crucial 32 GB DDR5 5200 MT/s (2x16, 1R)
      processor: "Intel i5-12600H (4 C [P, 4.5 GHz], 8 C [E, 3.3 GHz], 16 T, 18 MB)"
      boot: 2x boot partitions, one per storage NVMe
      storage: "2x 2 TB NVMe (Viper VP4300 2TB, WD_BLACK SN770 [4 TB raw]), 1 TB NVMe unused (WD Blue SN5100)"
      network: "On-board 2x 10Gb SFP+ (X710), 2x 2.5Gb Base-T, 2x USB4 (20GB [40Gb int])"
      pcie: Gen4 x16, unused
    }
    network: {
      shape: sql_table
      "0/1": LAN (bond0) {constraint: SFP+}
      "0/2": LAN (bond0) {constraint: SFP+}
      "0/3": MGMT {constraint: Base-T}
      "0/4": WAN (Planned) {constraint: Base-T}
      usb4/0: empty {constraint: TB40}
      usb4/1: pfsync (Planned) {constraint: TB40}
    }
  }
  n3: {
    grid-columns: 2
    os: {
      shape: sql_table
      role: Kubernetes etcd quorum
      host-os: NixOS
      vms: talos, rhel lab
    }
    hardware: {
      shape: sql_table
      platform: Dell Optiplex 7050 Micro
      memory: 16 GB DDR4 2400 MT/s (2x8, 1R)
      processor: Intel i7-7700T (4 C, 8 T, 2.9 GHz, 8 MB)
      boot: Not redundant
      storage: 256 GB NVMe, 256 GB SATA SSD
      pcie: Gen3 x4 (NVMe), x2 (unused)
    }
    network: {
      shape: sql_table
      "0/1": Cluster {constraint: Base-T}
      usb1: MGMT {constraint: Adapter}
    }
  }
  m1: {
    grid-columns: 2
    specs: {
      direction: down
      os: {
        shape: sql_table
        role: Storage
        host-os: NixOS
        vms: talos
      }
      hardware: {
        shape: sql_table
        platform: ASUS TUF Z390M-PRO
        memory: TEAMGROUP 64 GB DDR4 (4x16, 1R)
        processor: "Intel i7-9700k (8 C, 8 T, 12 MB)"
        boot: 2x boot partitions, one per NVMe
        storage: "2x Patriot P300 512 GB (mirrored), 2x Seagate 28 T (56 T raw [mirrored])"
        network: 2x 10GB SFP+ (X710), 1x 2.5Gb Base-T
        pcie: "Gen3 x16, unused; x1 unused"
      }
      network: {
        shape: sql_table
        "0/1": MGMT {constraint: Base-T}
        "1/1": LAN (bond0) {constraint: SFP+}
        "1/2": LAN (bond0) {constraint: SFP+}
      }
    }
    services: {
      userspace: |md
        - nfs-ganesha
        - seaweedfs
      |
    }
    libvirtd: |md
      talos
      opnsense
    |
  }
}
home: {
  catbox: {
    os: {
      shape: sql_table
      role: Gaming PC, TV
      host-os: NixOS
    }
    hardware: {
      shape: sql_table
      memory: Corsair 32 GB DDR5 5200 MT/s (2x16, 1R)
      board: "Gigabyte B850"
      processor: "AMD RYZEN 7 9800X3D"
      boot: Non-redundant
      storage: 2 TB Samsung 970 EVO Plus
      network: TODO
      usb: TP-Link UB500 Adapter
      pcie: AMD Radeon RX 7900 XT
    }
    network: {
      shape: sql_table
      "0/1": Home {constraint: Base-T}
    }
  }
}
