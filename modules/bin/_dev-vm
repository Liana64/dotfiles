#!/usr/bin/env bash
# home-infra devcontainer: pack $PWD into a read-only erofs volume at /work,
# boot the firecracker microVM, ssh in over hybrid vsock, tear down on exit.
# Image path and mux socket pair with modules/virt/dev-vm.nix.
set -euo pipefail

img=/run/dev-vm/work.img
mux=/var/lib/microvms/dev/notify.vsock

cleanup() {
  sudo systemctl stop microvm@dev.service
  sudo rm -f "$img"
}
trap cleanup EXIT

tmp=$(mktemp -u)
mkfs.erofs -L work "$tmp" "$PWD" >/dev/null
sudo install -m 0644 "$tmp" "$img"
rm -f "$tmp"

sudo systemctl start microvm@dev.service
nmcli connection up dev-vm >/dev/null

for _ in $(seq 60); do
  printf 'CONNECT 22\n' | socat -T 2 - "UNIX-CONNECT:$mux" 2>/dev/null | grep -q '^OK ' && break
  sleep 1
done

ssh -t \
  -o ProxyCommand="systemd-ssh-proxy %h %p" \
  -o ProxyUseFdpass=yes \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  "dev@vsock-mux$mux" 'cd /work && exec bash -l'
