#!/bin/sh
# @desc: PreToolUse hook — decline access to secrets files and commands
# Run `claude-secrets-guard --test` to execute the fixture.
set -f

# Token joiner: whitespace plus dash-led option words — these CLIs all take
# global flags between binary and subcommand (`kubectl get -n prod secret`).
sep='[[:space:]]+(-[^[:space:]]*([[:space:]]+[^-[:space:]][^[:space:]]*)?[[:space:]]+)*'

# <name> <ERE>, tokens joined by %S%. Word-boundary anchored so JSON keys,
# identifiers, and prose containing the same substrings do not match.
# Single-quoted so '$' and '\' reach the ERE literally.
bash_rules=$(printf '%s' '
kubectl-secret-access  \bkubectl\b.*\b(get|describe|edit)%S%secrets?\b
kubectl-view-secret    \bkubectl\b.*\bview-secret\b
vault-read             \bvault\b%S%(read|kv%S%(get|read))\b
aws-secret-read        \baws\b%S%secretsmanager%S%get-secret-value\b
aws-ssm-read           \baws\b%S%ssm%S%get-parameter\b
gcloud-secret-read     \bgcloud\b%S%secrets%S%versions%S%access\b
1password-read         \bop\b%S%(read|item%S%get)\b
bitwarden-read         \bbw\b%S%get\b
pass-show              \bpass\b%S%show\b
search-home-sweep      \b(rg|grep|find)\b.*[[:space:]](~|\$HOME|/home/[[:alnum:]._-]+)/?([[:space:]]|$)
rg-hidden-sweep        \brg\b.*[[:space:]]--?([[:alnum:]]*u[[:alnum:]]*u|hidden|unrestricted)\b
' | sed "s/%S%/$sep/g")

# Injected at wrap time from modules/_lib/secret-patterns.nix — single source
# with permissions.deny; the flake-check fixture injects the same values.
# Missing env fails closed: the hook blocks before any tool input is read.
file_globs=${CLAUDE_SECRET_GLOBS:?not set — run the wrapped binary}
dirs=${CLAUDE_SECRET_DIRS:?not set — run the wrapped binary}

deny() {
  jq -n --arg r "$1" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
  exit 0
}

# Path boundary. '*' counts so glob arguments (`rg -g '*.pem'`) match too.
b='[[:space:]=:"'\''/*]'; fn='[[:alnum:]._-]*'

# Turn a file glob into an ERE. A leading/trailing '*' means "any filename
# chars on that side", so the opposite side anchors on a path boundary while
# the wildcard side may carry a prefix/suffix (e.g. `terraform.tfvars` still
# matches `*.tfvars`). Globs without a '*' anchor on both sides so they do not
# match inside identifiers like `dotenv-linter`. Returns 1 for cores < 4 chars.
glob_to_re() {
  pat=$1 lead='' trail=''
  case "$pat" in \**) lead=1; pat=${pat#\*} ;; esac
  case "$pat" in *\*) trail=1; pat=${pat%\*} ;; esac
  [ ${#pat} -lt 4 ] && return 1
  esc=$(printf '%s' "$pat" | sed 's/[^[:alnum:]_-]/\\&/g')
  [ -n "$lead" ]  && L="(^|$b)$fn"   || L="(^|$b)"
  [ -n "$trail" ] && R="$fn(\$|$b)"  || R="(\$|$b)"
  printf '%s%s%s' "$L" "$esc" "$R"
}

# A secrets dir is a path component: slash on either side, since a recursive
# grep takes its search root bare (`rg foo ~/.aws`).
dir_to_re() {
  esc=$(printf '%s' "$1" | sed 's/[^[:alnum:]_-]/\\&/g')
  printf '((^|%s)%s/|/%s($|%s))' "$b" "$esc" "$esc" "$b"
}

scan_bash() {
  cmd=$1
  hit=$(printf '%s\n' "$bash_rules" | while read -r name re; do
    [ -z "$name" ] && continue
    printf '%s' "$cmd" | grep -Eq -- "$re" && { printf '%s' "$name"; break; }
  done)
  [ -n "$hit" ] && deny "secret-reading command declined: rule $hit"

  for pat in $file_globs; do
    re=$(glob_to_re "$pat") || continue
    if printf '%s' "$cmd" | grep -Eq -- "$re"; then
      deny "secrets-type file declined: command references $pat"
    fi
  done

  for d in $dirs; do
    if printf '%s' "$cmd" | grep -Eq -- "$(dir_to_re "$d")"; then
      deny "secrets directory declined: command references $d"
    fi
  done
}

scan_file() {
  path=$1
  base=${path##*/}
  for pat in $file_globs; do
    # shellcheck disable=SC2254  # unquoted: $pat must match as a glob
    case "$base" in
      $pat) deny "secrets-type file declined: $base ($pat)" ;;
    esac
  done
  for d in $dirs; do
    case "$path" in
      *"$d/"*) deny "secrets directory declined: $d" ;;
    esac
  done
}

run_tests() {
  fail=0
  bash_in() { jq -nc --arg c "$1" '{tool_name:"Bash",tool_input:{command:$c}}'; }
  read_in() { jq -nc --arg p "$1" '{tool_name:"Read",tool_input:{file_path:$p}}'; }
  t() {
    name=$1 expect=$2 input=$3
    # via sh: the source file carries no exec bit (in-repo or /nix/store)
    out=$(printf '%s' "$input" | sh "$0")
    if [ -z "$out" ]; then
      got=allow
    else
      got=$(printf '%s' "$out" | jq -r '.hookSpecificOutput.permissionDecision // "allow"')
    fi
    if [ "$got" = "$expect" ]; then
      printf 'PASS  %s\n' "$name"
    else
      printf 'FAIL  %s (want=%s got=%s)\n' "$name" "$expect" "$got"
      fail=1
    fi
  }

  t kubectl-patch-json-readonly allow "$(bash_in 'kubectl patch hr glance --type=json -p=[{"op":"add","path":"/x","value":{"readOnly":true}}]')"
  t prose-option-read   allow "$(bash_in 'echo the option to read')"
  t subway-getinfo      allow "$(bash_in 'echo subway-getinfo')"
  t kubectl-get-pods    allow "$(bash_in 'kubectl get pods')"
  t dotenv-linter       allow "$(bash_in 'echo dotenv-linter is fine')"

  t 1password-read      deny "$(bash_in 'op read op://vault/item/field')"
  t 1password-item-get  deny "$(bash_in 'op item get foo')"
  t kubectl-get-secret  deny "$(bash_in 'kubectl get secret foo')"
  t vault-kv-get        deny "$(bash_in 'vault kv get secret/foo')"
  t aws-secret          deny "$(bash_in 'aws secretsmanager get-secret-value --secret-id foo')"
  t bw-get              deny "$(bash_in 'bw get password foo')"

  t kubectl-flag-secret deny "$(bash_in 'kubectl get -n prod secret db-creds')"
  t kubectl-flag-oyaml  deny "$(bash_in 'kubectl get -o yaml secrets')"
  t kubectl-flag-pods   allow "$(bash_in 'kubectl get -n prod pods')"
  t vault-flag-read     deny "$(bash_in 'vault -namespace=x read secret/foo')"
  t aws-flag-secret     deny "$(bash_in 'aws --profile prod secretsmanager get-secret-value --secret-id foo')"
  t gcloud-flag-secret  deny "$(bash_in 'gcloud --project=x secrets versions access latest')"
  t op-flag-read        deny "$(bash_in 'op --account acme read op://vault/item/field')"
  t bw-flag-get         deny "$(bash_in 'bw --session PLACEHOLDER get password foo')"
  t pem-read            deny "$(read_in '/tmp/server.pem')"
  t ssh-dir             deny "$(read_in '/home/x/.ssh/id_rsa')"
  t secrets-dir         deny "$(read_in '/etc/nixos/secrets/wifi.psk')"
  t cat-tfvars-prefix   deny "$(bash_in 'cat tofu/lab/terraform.tfvars')"
  t cat-env-prefix      deny "$(bash_in 'cat /srv/app/production.env')"
  t cat-pem-prefix      deny "$(bash_in 'cat /etc/ssl/server.pem')"
  t cat-kubeconfig      deny "$(bash_in 'cat ~/prod.kubeconfig')"
  t echo-environment-ok allow "$(bash_in 'echo my.environment is set')"

  t prose-secrets-word  allow "$(bash_in 'echo handle secrets carefully')"
  t rg-bare-dir         deny "$(bash_in 'rg -i password ~/.aws')"
  t grep-r-bare-dir     deny "$(bash_in 'grep -r token /home/x/.gnupg')"
  t grep-secrets-root   deny "$(bash_in 'grep key /etc/nixos/secrets')"
  t rg-relative-dir     deny "$(bash_in 'rg -l KEY ./secrets')"
  t rg-glob-filter      deny "$(bash_in "rg pattern -g '*.pem' .")"
  t rg-type-add-glob    deny "$(bash_in 'rg --glob=*.tfvars secret')"

  t rg-home-bare        deny "$(bash_in 'rg pattern ~')"
  t rg-home-slash       deny "$(bash_in 'rg pattern ~/')"
  t rg-home-var         deny "$(bash_in 'rg pattern $HOME')"
  t grep-home-abs       deny "$(bash_in 'grep -r token /home/someone')"
  t find-home-bare      deny "$(bash_in 'find ~ -name config')"
  t rg-hidden-flag      deny "$(bash_in 'rg --hidden pattern ./src')"
  t rg-unrestricted-uu  deny "$(bash_in 'rg -uuu PRIVATEKEY ~/Projects')"
  t rg-scoped-ok        allow "$(bash_in 'rg pattern ~/Projects/foo')"
  t rg-plain-ok         allow "$(bash_in 'rg --no-heading pattern ./src')"
  t rg-single-u-ok      allow "$(bash_in 'rg -u pattern ./src')"

  exit $fail
}

[ "$1" = "--test" ] && run_tests

input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty')

case "$tool" in
  Read|Edit|MultiEdit|Write|NotebookEdit)
    path=$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')
    [ -n "$path" ] && scan_file "$path" ;;
  Bash)
    cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
    [ -n "$cmd" ] && scan_bash "$cmd" ;;
esac

exit 0
