#!/bin/sh
# @desc: ctar — signed+encrypted tar archives using YubiKey
set -eu

usage() {
  echo "usage: ctar <path> [out.tar.gz.gpg]" >&2
  echo "       ctar -d <archive.tar.gz.gpg> [dir]" >&2
  exit 1
}

[ $# -ge 1 ] || usage

if [ "$(id -u)" = 0 ]; then
  echo "ctar: run unprivileged — tar is escalated on its own when needed" >&2
  exit 1
fi

case "$1" in
-d)
  shift
  [ $# -ge 1 ] || usage
  src=$(realpath "$1")
  dest=$(realpath "${2:-.}")
  [ -d "$dest" ] || {
    echo "ctar: not a directory: $dest" >&2
    exit 1
  }

  status=$(mktemp)
  work=$(mktemp -d "$dest/.ctar.XXXXXX")
  trap 'rm -f "$status"; rm -rf "$work"' EXIT

  echo "Touch key if needed" >&2
  gpg --status-fd 3 -d "$src" 3>"$status" | tar xzf - -C "$work"
  grep -q '^\[GNUPG:\] VALIDSIG' "$status" || {
    echo "ctar: no valid signature on $src — nothing extracted" >&2
    exit 1
  }

  find "$work" -mindepth 1 -maxdepth 1 -exec mv -t "$dest" {} +
  echo "$dest"
  ;;
-*)
  usage
  ;;
*)
  src=$(realpath "$1")
  name=$(basename "$src")
  dest=${2:-$PWD/$name.tar.gz.gpg}

  if [ -n "$(find "$src" ! -readable -print -quit 2>/dev/null)" ]; then
    sudo -v
    set -- sudo tar
  else
    set -- tar
  fi

  status=$(mktemp)
  trap 'rm -f "$status" "$dest.partial"' EXIT

  echo "Touch key if needed" >&2
  {
    "$@" czf - -C "$(dirname "$src")" "./$name" || echo fail >"$status"
  } | gpg --sign --encrypt --default-recipient-self --yes -o "$dest.partial"

  if [ -s "$status" ]; then
    echo "ctar: tar failed — $dest not written" >&2
    exit 1
  fi

  mv "$dest.partial" "$dest"
  echo "$dest"
  ;;
esac
