#!/bin/sh
# @desc: ctar — signed+encrypted tar archives using YubiKey
set -eu

usage() {
  echo "usage: ctar <path> [out.tar.zst.gpg]" >&2
  echo "       ctar -d <archive.tar.zst.gpg> [dir]" >&2
  exit 1
}

[ $# -ge 1 ] || usage

if [ "$(id -u)" = 0 ]; then
  echo "ctar: run unprivileged — tar is escalated on its own when needed" >&2
  exit 1
fi

case "$1" in
-d)
  shift
  [ $# -ge 1 ] || usage
  src=$(realpath "$1")
  dest=$(realpath "${2:-.}")
  [ -d "$dest" ] || {
    echo "ctar: not a directory: $dest" >&2
    exit 1
  }

  status=$(mktemp)
  work=$(mktemp -d "$dest/.ctar.XXXXXX")
  trap 'rm -f "$status"; rm -rf "$work"' EXIT

  sigcheck() {
    grep -q '^\[GNUPG:\] VALIDSIG' "$status" || {
      echo "ctar: no valid signature on $src — nothing extracted" >&2
      exit 1
    }
  }

  unz() {
    case "$src" in
    *.gz.gpg) gzip -dc ;;
    *) zstd -dc ;;
    esac
  }

  if [ -f "$src.sig" ]; then
    gpg --status-fd 3 --verify "$src.sig" "$src" 3>"$status" || :
    sigcheck
    echo "Touch key if needed" >&2
    gpg -d "$src" | unz | tar xf - -C "$work"
  else
    case "$src" in
    *.gz.gpg) ;;
    *)
      printf 'ctar: %s.sig not found — extract unverified? [y/N] ' "$src" >&2
      read -r ans </dev/tty
      case "$ans" in
      [yY]) sigcheck() { :; } ;;
      *)
        echo "ctar: nothing extracted" >&2
        exit 1
        ;;
      esac
      ;;
    esac
    echo "Touch key if needed" >&2
    gpg --status-fd 3 -d "$src" 3>"$status" | unz | tar xf - -C "$work"
    sigcheck
  fi

  find "$work" -mindepth 1 -maxdepth 1 -exec mv -t "$dest" {} +
  echo "$dest"
  ;;
-*)
  usage
  ;;
*)
  src=$(realpath "$1")
  name=$(basename "$src")
  dest=${2:-$PWD/$name.tar.zst.gpg}

  if [ -n "$(find "$src" ! -readable -print -quit 2>/dev/null)" ]; then
    sudo -v
    set -- sudo tar
  else
    set -- tar
  fi

  status=$(mktemp)
  trap 'rm -f "$status" "$dest.partial"' EXIT

  {
    "$@" cf - -C "$(dirname "$src")" "./$name" || echo fail >"$status"
  } | {
    zstd -T0 || echo fail >"$status"
  } | gpg --encrypt --compress-algo none --default-recipient-self --yes -o "$dest.partial"

  if [ -s "$status" ]; then
    echo "ctar: archive stream failed — $dest not written" >&2
    exit 1
  fi

  rm -f "$dest.sig"
  mv "$dest.partial" "$dest"

  echo "Touch key" >&2
  until gpg --yes --detach-sign "$dest"; do
    echo "ctar: signing failed — touch and retry" >&2
    sleep 1
  done
  echo "$dest"
  ;;
esac
