#!/bin/sh
# @desc: kill stray Claude Code processes — every "claude" match bar the matchers and this script
# shellcheck disable=SC2086 # pid lists are split on purpose

# this script's own store path holds "claude", as do the subshells forked from it
pids=$(ps -eww -o pid=,args= |
  awk '/claude/ && $2 !~ /(awk|rg|grep)$/ && $2 !~ /harness-clean/ {printf "%s ", $1}')

[ -n "$pids" ] || {
  echo "harness-clean: nothing to clean"
  exit 0
}
echo "harness-clean: killing $pids"

kill $pids 2>/dev/null
sleep 2
kill -9 $pids 2>/dev/null
exit 0
