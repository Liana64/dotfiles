#!/bin/sh
# @desc: Build the installer ISO into the current directory
# Usage: nix-build-installer [flake-dir] [nix build args...]

set -eu

dir=${DOTFILES:-/nix/dotfiles}
case ${1:-} in
'' | -*) ;;
*)
  dir=$1
  shift
  ;;
esac

if [ ! -f "$dir/flake.nix" ]; then
  printf 'no flake at %s\n' "$dir" >&2
  exit 1
fi

attr=nixosConfigurations.installer.config.system.build.isoImage
out=$(nix build --no-link --print-out-paths "$dir#$attr" "$@")

set -- "$out"/iso/*.iso
if [ ! -f "$1" ]; then
  printf 'no iso under %s\n' "$out" >&2
  exit 1
fi
name=${1##*/}

tmp=./.$name.part
trap 'rm -f "$tmp"' EXIT
cp "$1" "$tmp"
chmod 644 "$tmp"
mv "$tmp" "./$name"
