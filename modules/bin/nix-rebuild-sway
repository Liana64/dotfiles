#!/usr/bin/env bash
# @desc: frame switch in a scratchpad kitty, surfaced on prompt or failure; tracked via rebuild-track under this pid
set -u

if [ "${1:-}" != --run ]; then
  id=$(date +%s%N)
  unset XDG_ACTIVATION_TOKEN DESKTOP_STARTUP_ID
  setsid -f kitty --title "nix-rebuild $id" nix-rebuild-sway --run "$id" "$@" >/dev/null 2>&1
  exit
fi
title="nix-rebuild $2"
shift 2

add=
[ "${1:-}" = add ] && add=1 && shift
host=${1:-}

s=$XDG_RUNTIME_DIR/nix-rebuild/$$
export REBUILD_PID=$$
reveal() { swaymsg -q "[title=\"^$title\$\"] focus"; }
signal() { systemctl --user kill -s "RTMIN+$1" --kill-whom=main waybar.service 2>/dev/null; }
trap 'rm -f "$s".*; signal 9' EXIT

[ -n "$add" ] && git -C "$NH_FLAKE" add --all

(
  while kill -0 $$ 2>/dev/null && sleep 1; do
    tail -c 512 "$s.log" 2>/dev/null | tr '\r' '\n' | tail -n 2 |
      grep -qiE 'password|finger|\[y/n\]|yes/no' && reveal && break
  done
) &
watch=$!

frame switch ${host:+"$host"}
rc=$?
kill "$watch" 2>/dev/null

if [ "$rc" -eq 0 ]; then
  notify-send -a nix-rebuild "${host:-$(hostname)} switched"
  exit
fi

mkdir -p "${s%/*}"
printf '%s\n' "${host:-$(hostname)} switch" >"$s.host"
echo "$rc" >"$s.rc"
signal 9
reveal
echo ""
echo "Failed ($rc). Press any key to close..."
read -n 1 -s -r
